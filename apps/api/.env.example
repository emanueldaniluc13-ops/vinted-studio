PORT=4000
# En local: http://localhost:3000. En producción: la URL de tu web en Vercel (varias separadas por comas)
WEB_ORIGIN=http://localhost:3000

# Supabase > botón «Connect»: copia «Transaction pooler» (puerto 6543) y «Session pooler» (puerto 5432)
DATABASE_URL="postgresql://postgres.XXXX:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.XXXX:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase > Project Settings > API: URL del proyecto y la clave secreta (service_role). Nunca la compartas.
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=photos

# Texto largo y secreto (mínimo 16 caracteres): cifra la clave de IA y firma las sesiones
ENCRYPTION_SECRET=cambia-esto-por-un-texto-largo-y-secreto
# Contraseña para entrar a la app. OBLIGATORIA en producción.
APP_PASSWORD=
